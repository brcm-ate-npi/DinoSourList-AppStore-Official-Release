<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DinoSaurList.App" RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button"><Setter Property="Background" Value="#EFEDFF"/><Setter Property="Foreground" Value="#4837C8"/><Setter Property="Padding" Value="14,9"/><Setter Property="CornerRadius" Value="7"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="10,6"/><Setter Property="MinHeight" Value="36"/><Setter Property="BorderBrush" Value="#CCD3E0"/></Style>
    <Style Selector="ComboBoxItem"><Setter Property="CornerRadius" Value="6"/><Setter Property="Margin" Value="4,2"/></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="38"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Opacity" Value=".65"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}"/><Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#40808080"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  </Application.Styles>
</Application>
