<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:DinoSaurList.ViewModels" xmlns:model="using:DinoSaurList.Core.Registry"
 xmlns:profile="using:DinoSaurList.Core.Profile" xmlns:assistant="using:DinoSaurList.Core.Assistant" x:Class="DinoSaurList.MainWindow" x:DataType="vm:MainViewModel"
 Title="DinoSaurList" Width="1240" Height="820" MinWidth="900" MinHeight="600" Icon="avares://DinoSaurList/Assets/dinosaur.ico">
 <Window.Styles>
  <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#57527D"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,5"/><Setter Property="Padding" Value="12,13"/></Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#EFEDFF"/></Style>
  <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </Window.Styles>
 <Grid ColumnDefinitions="210,*" RowDefinitions="*,Auto">
  <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#EAEAF1" BorderThickness="0,0,1,0" Padding="14,24" Grid.RowSpan="2">
   <DockPanel LastChildFill="True">
    <Button DockPanel.Dock="Top" Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="Assistant" Margin="0,0,0,24"><StackPanel Orientation="Horizontal" Spacing="10"><Image Source="avares://DinoSaurList/Assets/dinosaur.ico" Width="42" Height="42"/><TextBlock Text="AI Assistant" Foreground="#4837C8" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/></StackPanel></Button>
    <StackPanel DockPanel.Dock="Bottom" Spacing="5"><TextBlock Text="{Binding UserName}" Classes="caption"/><TextBlock Text="{Binding LocalCount}" Classes="caption"/><TextBlock Text="{Binding StoreCount}" Classes="caption"/><TextBlock Text="{Binding CategoryCount}" Classes="caption"/><Button Classes="nav" Content="⚙  Setting" Command="{Binding NavigateCommand}" CommandParameter="Settings"/><Button Classes="nav" Content="Exit" Command="{Binding ExitCommand}" Background="#FDEDEE" Foreground="#C83D4E"/><TextBlock Text="{Binding AppVersion}" Classes="caption"/></StackPanel>
    <StackPanel>
     <Button Classes="nav" Content="🚀  Local Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Installed"/>
     <Button Classes="nav" Content="▣  Software Store" Command="{Binding NavigateCommand}" CommandParameter="Store"/>
     <Button Classes="nav" Content="🏅  Dev Profile" Command="{Binding NavigateCommand}" CommandParameter="Developers"/>
     <Button Classes="nav" Content="★  Favourites" Command="{Binding ShowFavouritesCommand}"/>
     <Button Classes="nav" Content="↗  Useful Links" Command="{Binding UsefulLinksCommand}"/>
     <Button Classes="nav" Content="▤  News Updates" Command="{Binding NavigateCommand}" CommandParameter="News"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24">
   <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20"><TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Refresh catalogue" Command="{Binding RefreshCommand}" IsEnabled="{Binding Idle}"/><Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}"/></StackPanel></Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsStore}" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,200,Auto" Margin="0,0,0,14"><TextBox PlaceholderText="Search tools, authors or categories" Text="{Binding Search}"/><CheckBox Grid.Column="1" Content="List View" IsChecked="{Binding ListView}" Margin="12,0"/><ComboBox Name="CategoryPicker" Grid.Column="2" Margin="10,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch"/><CheckBox Grid.Column="3" Content="Favourites only" IsChecked="{Binding FavouritesOnly}"/></Grid>
    <Grid Grid.Row="1" RowDefinitions="*,Auto">
     <ScrollViewer HorizontalScrollBarVisibility="Disabled"><ItemsControl Name="ToolList" ItemsSource="{Binding ToolSections}">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ToolSection"><Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,18" BorderThickness="0">
       <ItemsControl ItemsSource="{Binding Tools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ToolCardViewModel">
         <Border Classes="card" Width="{Binding CardWidth}" Margin="0,0,18,18" Padding="18" MinHeight="{Binding CardHeight}">
          <Grid>
          <StackPanel IsVisible="{Binding !IsListView}" Spacing="12">
           <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><Button Content="Details" Command="{Binding DetailsCommand}" Padding="8,3" FontSize="11" HorizontalAlignment="Left"/><Button Content="ReadMe" Command="{Binding ReadmeCommand}" Padding="8,3" FontSize="11" HorizontalAlignment="Left"/></StackPanel><Button Grid.Column="1" Command="{Binding FavouriteCommand}" ToolTip.Tip="Toggle favourite" Padding="6"><TextBlock Text="{Binding FavouriteGlyph}" Foreground="#C89A25"/></Button></Grid>
           <Button Command="{Binding DetailsCommand}" HorizontalAlignment="Center" Background="Transparent" Padding="0"><Grid Width="84" Height="84"><Border Background="#EDEBFF" CornerRadius="9" IsVisible="{Binding !HasIcon}"><TextBlock Text="{Binding Initial}" Foreground="#5145AA" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="Uniform"/></Grid></Button>
           <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{Binding Author, StringFormat='by {0}'}" Classes="caption" TextAlignment="Center"/></StackPanel>
           <Grid ColumnDefinitions="*,Auto"><ComboBox IsVisible="{Binding !IsDashboard}" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedCardPackage, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="110"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:ToolPackage"><TextBlock Text="{Binding Version}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox IsVisible="{Binding IsDashboard}" ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedCardInstallation, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="110"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:InstalledTool"><TextBlock Text="{Binding Version}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanUse}" Padding="9,6" Margin="6,0,0,0"/></Grid>
           <TextBlock Text="{Binding UpdateStatus}" Classes="caption" TextAlignment="Center"/>
          </StackPanel>
          <Grid IsVisible="{Binding IsListView}" ColumnDefinitions="64,*,130,Auto" ColumnSpacing="12">
           <Grid Width="52" Height="52"><Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="Uniform"/><TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasIcon}" FontSize="32" Foreground="#5145AA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Author, StringFormat='by {0}'}" Classes="caption"/><TextBlock Text="{Binding UpdateStatus}" Classes="caption"/></StackPanel>
           <Grid Grid.Column="2" VerticalAlignment="Center"><ComboBox IsVisible="{Binding !IsDashboard}" ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedCardPackage, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:ToolPackage"><TextBlock Text="{Binding Version}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox IsVisible="{Binding IsDashboard}" ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedCardInstallation, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:InstalledTool"><TextBlock Text="{Binding Version}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
           <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><Button Content="Details" Command="{Binding DetailsCommand}" Padding="8,6"/><Button Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanUse}" Padding="9,6"/></StackPanel>
          </Grid>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </Expander></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl></ScrollViewer><StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0"><TextBlock Text="{Binding VisibleCount}" Classes="caption"/><Button Content="Import tools from the Python installation…" Command="{Binding BrowseLegacyCommand}" IsEnabled="{Binding Idle}" IsVisible="{Binding IsDashboard}" HorizontalAlignment="Left"/></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" Grid.Column="1" IsVisible="{Binding DetailsVisible}" Width="320" Margin="16,0,0,0"><StackPanel Spacing="12" IsVisible="{Binding HasSelection}"><Button Content="Close details" Command="{Binding CloseDetailsCommand}"/>
     <TextBlock Text="{Binding SelectedTool.Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding SelectedTool.Author}" Classes="caption"/>
     <TextBlock Text="{Binding SelectedTool.Compatibility}" TextWrapping="Wrap"/>
     <Button Content="★ Toggle favourite" Command="{Binding FavouriteCommand}" IsEnabled="{Binding Idle}"/>
     <TextBlock Text="Available versions" FontWeight="SemiBold"/>
     <ComboBox Name="PackagePicker" ItemsSource="{Binding AvailablePackages}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="model:ToolPackage"><TextBlock Text="{Binding FileName}"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <Button Name="InstallButton" Content="Install selected version" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" HorizontalAlignment="Stretch"/>
     <Button Content="README" Command="{Binding ReadmeCommand}" IsEnabled="{Binding Idle}"/>
     <Button Content="Open user guide" Command="{Binding GuideCommand}" IsEnabled="{Binding Idle}"/>
     <TextBlock Text="Installed versions / rollback" FontWeight="SemiBold" Margin="0,15,0,0"/>
     <ComboBox ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:InstalledTool"><TextBlock Text="{Binding Version}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <Button Content="Open selected installed version" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" HorizontalAlignment="Stretch"/>
     <Button Content="Activate / roll back to this version" Command="{Binding PinVersionCommand}" IsEnabled="{Binding CanLaunch}"/>
     <Button Content="Remove selected version…" Command="{Binding RemoveVersionCommand}" IsEnabled="{Binding CanLaunch}"/>
     <TextBlock Text="{Binding SelectedInstallation.Directory}" Classes="caption" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsAssistant}" RowDefinitions="Auto,Auto,*"><StackPanel Orientation="Horizontal" Spacing="10"><TextBox Width="500" Text="{Binding Query}" PlaceholderText="Describe your task…"/><Button Content="Find tools" Command="{Binding RecommendCommand}"/><Button Content="Index READMEs" Command="{Binding IndexDocumentationCommand}" IsEnabled="{Binding Idle}"/></StackPanel><StackPanel Grid.Row="1" Margin="0,14" Spacing="8"><TextBlock Text="{Binding AssistantStatus}" TextWrapping="Wrap"/><ScrollViewer MaxHeight="260"><SelectableTextBlock Text="{Binding AssistantResponse}" TextWrapping="Wrap"/></ScrollViewer></StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding Recommendations}"><ListBox.ItemTemplate><DataTemplate x:DataType="assistant:Recommendation"><StackPanel Margin="12" Spacing="5"><TextBlock Text="{Binding Tool.Name}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding Tool.Category}"/><TextBlock Text="{Binding Score, StringFormat='Similarity: {0:P0}'}"/><Button Content="View tool" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectRecommendationCommand}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
   <ContentControl Grid.Row="1" Name="UsefulLinksViewer" IsVisible="{Binding IsLinks}"/>
   <Grid Grid.Row="1" IsVisible="{Binding IsNews}" RowDefinitions="*,Auto"><ContentControl Name="NewsViewer"/><Expander Grid.Row="1" Header="Edit local news" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBox AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding News}" Height="180"/><Button Content="Save local news" Command="{Binding SaveNewsCommand}" HorizontalAlignment="Left"/></StackPanel></Expander></Grid>
   <ScrollViewer Grid.Row="1" IsVisible="{Binding IsProfile}"><StackPanel Spacing="16" Margin="0,0,16,0">
    <Border Classes="card"><Grid ColumnDefinitions="86,*,220"><Grid Width="68" Height="68"><Border CornerRadius="34" Background="#A755CF"><TextBlock Text="{Binding ProfileInitial}" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Image Source="{Binding ProfilePhoto}"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"><TextBlock Text="{Binding ProfileName}" FontSize="25" FontWeight="Bold"/><TextBlock Text="Developer" Classes="caption"/></StackPanel><StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Developer" Classes="caption"/><ComboBox IsEnabled="{Binding Idle}" ItemsSource="{Binding Authors}" SelectedItem="{Binding ProfileName}" HorizontalAlignment="Stretch"/><Button Content="Load shared profile" Command="{Binding LoadSharedProfileCommand}"/></StackPanel></Grid></Border>
    <Border Classes="card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="📌  Pinned message" FontWeight="SemiBold" Foreground="#5145C0"/><Button Grid.Column="1" Content="Edit" Command="{Binding EditProfileCommand}"/></Grid><TextBlock Text="{Binding ProfileMessage}" TextWrapping="Wrap"/><TextBlock Text="Synced with Box" Classes="caption"/>
     <StackPanel IsVisible="{Binding EditingProfile}" Spacing="10"><TextBox Text="{Binding ProfileMessage}" MaxLength="280" AcceptsReturn="True" MinHeight="80"/><TextBlock Text="Shared links: title | URL | optional Jira key"/><TextBox Text="{Binding ProfileLinksText}" AcceptsReturn="True" MinHeight="80"/><Button Content="Change profile photo…" Command="{Binding ChangePhotoCommand}"/><Button Content="Save to Box" Command="{Binding SaveSharedProfileCommand}"/></StackPanel>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Jira tickets / Shared links" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ProfileLinks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="profile:ProfileLink"><Grid ColumnDefinitions="*,Auto" Margin="0,6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Key}" Classes="caption"/></StackPanel><Button Grid.Column="1" Content="Open ↗" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenProfileLinkCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <UniformGrid Columns="5"><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileApplications}" FontSize="24" FontWeight="Bold"/><TextBlock Text="applications" Classes="caption"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileVersions}" FontSize="24" FontWeight="Bold"/><TextBlock Text="versions published" Classes="caption"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileUpdates}" FontSize="24" FontWeight="Bold"/><TextBlock Text="updates this year" Classes="caption"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileActiveDays}" FontSize="24" FontWeight="Bold"/><TextBlock Text="active days" Classes="caption"/></StackPanel></Border><Border Classes="card"><StackPanel><TextBlock Text="{Binding ProfileStreak}" FontSize="24" FontWeight="Bold"/><TextBlock Text="longest streak (days)" Classes="caption"/></StackPanel></Border></UniformGrid>
    <Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,150"><TextBlock Text="Box contributions" FontSize="18" FontWeight="SemiBold"/><NumericUpDown Grid.Column="1" Value="{Binding ContributionYear}" Minimum="1970" Maximum="9998" Increment="1" FormatString="0"/></Grid><TextBlock Text="{Binding ContributionSummary}" TextWrapping="Wrap" Classes="caption"/><ScrollViewer HorizontalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ContributionDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Vertical" Height="105"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ContributionCell"><Border Width="12" Height="12" CornerRadius="2" Margin="1.5" Background="{Binding Colour}" ToolTip.Tip="{Binding Label}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
    <Expander Header="Personal Jira shortcut and local activity" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><TextBox Text="{Binding JiraUrl}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Save profile" Command="{Binding SaveSettingsCommand}"/><Button Content="Open Jira" Command="{Binding OpenJiraCommand}"/></StackPanel><SelectableTextBlock Text="{Binding ProfileActivity}"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
   <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSettings}"><StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch">
    <TextBlock Text="Box Manager server"/><TextBox Text="{Binding BoxManagerUrl}"/><TextBlock Text="Velopack update feed"/><TextBox Text="{Binding UpdateFeedUrl}"/>
    <TextBlock Text="Theme (System, Light or Dark)"/><TextBox Text="{Binding Theme}"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding Idle}"/>
    <TextBlock Text="Refresh mode" FontWeight="SemiBold"/><TextBlock Text="1: All metadata + documents · 2: Selected tools · 3: Metadata only · 4: New tools only" TextWrapping="Wrap"/><NumericUpDown Value="{Binding RefreshMode}" Minimum="1" Maximum="4" Increment="1" FormatString="0"/><TextBox PlaceholderText="Mode 2: comma-separated folder names (Name-Author)" Text="{Binding RefreshSelectedFolders}"/>
    <Button Content="Activity log" Command="{Binding NavigateCommand}" CommandParameter="Logs"/><TextBlock Text="Application updates" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Check" Command="{Binding CheckUpdatesCommand}"/><Button Content="Download update" Command="{Binding DownloadUpdateCommand}"/><Button Content="Restart to update" Command="{Binding ApplyUpdateCommand}"/></StackPanel><TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"/>
    <TextBlock Text="Import from the Python application" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBox PlaceholderText="Existing DinoSaurList folder" Text="{Binding LegacyRoot}"/><TextBlock Text="{Binding LegacySummary}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview import" Command="{Binding PreviewLegacyCommand}" IsEnabled="{Binding Idle}"/><Button Content="Import previewed items" Command="{Binding ImportLegacyCommand}" IsEnabled="{Binding Idle}"/></StackPanel>
    <TextBlock Text="Per-user data directory" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"/><SelectableTextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap"/><Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/>
   </StackPanel></ScrollViewer>
   <ListBox Grid.Row="1" IsVisible="{Binding IsLogs}" ItemsSource="{Binding Logs}"/>
  </Grid>
  <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="#40808080" Padding="24,10"><Grid ColumnDefinitions="*,180"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><ProgressBar Grid.Column="1" Value="{Binding Progress}" IsVisible="{Binding Busy}" Height="6" Margin="12,0,0,0"/></Grid></Border>
 </Grid>
</Window>
