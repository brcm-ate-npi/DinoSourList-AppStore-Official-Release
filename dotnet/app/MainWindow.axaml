<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:DinoSaurList.ViewModels" xmlns:model="using:DinoSaurList.Core.Registry"
 xmlns:profile="using:DinoSaurList.Core.Profile" xmlns:assistant="using:DinoSaurList.Core.Assistant" x:Class="DinoSaurList.MainWindow" x:DataType="vm:MainViewModel"
 Title="{Binding WindowTitle}" Width="1240" Height="1000" MinWidth="900" MinHeight="600" Icon="avares://DinoSaurList/Assets/dinosaur.ico">
 <Window.Styles>
  <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#57527D"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,5"/><Setter Property="Padding" Value="12,13"/></Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#EFEDFF"/></Style>
  <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </Window.Styles>
 <Grid Name="ShellGrid" ColumnDefinitions="Auto,*" RowDefinitions="*,Auto">
  <Border Name="Sidebar" Width="{Binding SidebarWidth}" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="#EAEAF1" BorderThickness="0,0,1,0" Padding="8,16" Grid.RowSpan="2">
   <DockPanel LastChildFill="True">
    <Button Name="SidebarToggle" DockPanel.Dock="Top" Content="{Binding SidebarToggleGlyph}" Command="{Binding ToggleSidebarCommand}" HorizontalAlignment="Right" Padding="10,2" ToolTip.Tip="Collapse / expand sidebar" AutomationProperties.Name="Collapse or expand sidebar"/>
    <Button DockPanel.Dock="Top" Classes="nav" Name="AssistantButton" ToolTip.Tip="AI Assistant" Command="{Binding OpenAssistantCommand}" Margin="0,8,0,16" Padding="4,9"><Grid ColumnDefinitions="36,*" ColumnSpacing="8"><Image Source="avares://DinoSaurList/Assets/dinosaur.ico" Width="32" Height="32"/><TextBlock Grid.Column="1" Text="AI Assistant" IsVisible="{Binding !SidebarCollapsed}" Foreground="#4837C8" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/></Grid></Button>
    <StackPanel Name="SidebarFooter" DockPanel.Dock="Bottom" Spacing="5"><Border Name="UserInfoSeparator" Height="1" Background="#40808080" Margin="0,10,0,12"/><StackPanel Orientation="Horizontal" Spacing="8"><Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,22 V19 C4,13 20,13 20,19 V22" Stroke="#77718D" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{Binding UserName}" Classes="caption" IsVisible="{Binding !SidebarCollapsed}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Path Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M2,12 H22 M12,2 C5,8 5,16 12,22 M12,2 C19,8 19,16 12,22" Stroke="#77718D" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Name="LocalIpLabel" Text="{Binding LocalIp}" Classes="caption" IsVisible="{Binding !SidebarCollapsed}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Path Data="M12,2 V16 M6,10 L12,16 L18,10 M3,16 V22 H21 V16" Stroke="#77718D" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{Binding LocalCount}" Classes="caption" IsVisible="{Binding !SidebarCollapsed}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Path Data="M3,9 V22 H21 V9 M1,9 L4,2 H20 L23,9 Z M8,22 V14 H16 V22" Stroke="#77718D" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{Binding StoreCount}" Classes="caption" IsVisible="{Binding !SidebarCollapsed}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><Path Data="M2,2 H12 L22,12 L12,22 L2,12 Z M6,6 H7 V7 H6 Z" Stroke="#77718D" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Text="{Binding CategoryCount}" Classes="caption" IsVisible="{Binding !SidebarCollapsed}"/></StackPanel><Button Classes="nav" ToolTip.Tip="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M5,5 L7,7 M17,17 L19,19 M5,19 L7,17 M17,7 L19,5 M12,7 A5,5 0 1 0 12,17 A5,5 0 1 0 12,7" Width="18" Height="18" Stretch="Uniform" Stroke="#77718D" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Text="Settings" Grid.Column="1" IsVisible="{Binding !SidebarCollapsed}" VerticalAlignment="Center"/></Grid></Button><Button Classes="nav" Content="{Binding ExitLabel}" ToolTip.Tip="Exit" Command="{Binding ExitCommand}" Background="#FDEDEE" Foreground="#C83D4E"/></StackPanel>
    <ScrollViewer Name="SidebarNavigation" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,12">
     <Button Name="DashboardNav" Classes="nav" ToolTip.Tip="Local Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Installed"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="M2,2 H9 V9 H2 Z M13,2 H20 V9 H13 Z M2,13 H9 V20 H2 Z M13,13 H20 V20 H13 Z" Width="18" Height="18" Stretch="Uniform" Stroke="#77718D" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Name="DashboardNavLabel" Grid.Column="1" Text="Local Dashboard" IsVisible="{Binding !SidebarCollapsed}" VerticalAlignment="Center"/></Grid></Button>
     <Button Name="StoreNav" Classes="nav" ToolTip.Tip="Software Store" Command="{Binding NavigateCommand}" CommandParameter="Store"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="M3,9 V21 H21 V9 M1,9 L4,2 H20 L23,9 Z M8,21 V14 H16 V21" Width="18" Height="18" Stretch="Uniform" Stroke="#77718D" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Name="StoreNavLabel" Grid.Column="1" Text="Software Store" IsVisible="{Binding !SidebarCollapsed}" VerticalAlignment="Center"/></Grid></Button>
     <Button Name="ProfileNav" Classes="nav" ToolTip.Tip="Dev Profile" Command="{Binding NavigateCommand}" CommandParameter="Developers"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,22 V19 C4,13 20,13 20,19 V22" Width="18" Height="18" Stretch="Uniform" Stroke="#77718D" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Name="ProfileNavLabel" Grid.Column="1" Text="Dev Profile" IsVisible="{Binding !SidebarCollapsed}" VerticalAlignment="Center"/></Grid></Button>
     <Button Name="FavouritesNav" Classes="nav" ToolTip.Tip="Favourites" Command="{Binding ShowFavouritesCommand}"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="M12,2 L15,9 L23,10 L17,15 L19,23 L12,19 L5,23 L7,15 L1,10 L9,9 Z" Width="18" Height="18" Stretch="Uniform" Stroke="#77718D" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Name="FavouritesNavLabel" Grid.Column="1" Text="Favourites" IsVisible="{Binding !SidebarCollapsed}" VerticalAlignment="Center"/></Grid></Button>
     <Button Name="LinksNav" Classes="nav" ToolTip.Tip="Useful Links" Command="{Binding UsefulLinksCommand}"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="M14,2 H22 V10 M22,2 L10,14 M10,4 H3 V21 H20 V14" Width="18" Height="18" Stretch="Uniform" Stroke="#77718D" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Name="LinksNavLabel" Grid.Column="1" Text="Useful Links" IsVisible="{Binding !SidebarCollapsed}" VerticalAlignment="Center"/></Grid></Button>
     <Button Name="NewsNav" Classes="nav" ToolTip.Tip="News Updates" Command="{Binding NavigateCommand}" CommandParameter="News"><Grid ColumnDefinitions="22,*" ColumnSpacing="10"><Path Data="M3,2 H21 V22 H3 Z M7,7 H17 M7,12 H17 M7,17 H14" Width="18" Height="18" Stretch="Uniform" Stroke="#77718D" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Name="NewsNavLabel" Grid.Column="1" Text="News Updates" IsVisible="{Binding !SidebarCollapsed}" VerticalAlignment="Center"/></Grid></Button>
    </StackPanel></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24">
   <StackPanel Margin="0,0,0,20" Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Refresh catalogue" Command="{Binding RefreshCommand}" IsEnabled="{Binding Idle}"/><Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}"/></StackPanel></Grid>
   </StackPanel>
   <Grid Grid.Row="1" IsVisible="{Binding IsStore}" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,200,Auto" Margin="0,0,0,14"><TextBox PlaceholderText="Search tools, authors or categories" Text="{Binding Search}"/><CheckBox Grid.Column="1" Content="List View" IsChecked="{Binding ListView}" Margin="12,0"/><ComboBox Name="CategoryPicker" Grid.Column="2" Margin="10,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" HorizontalAlignment="Stretch"/><CheckBox Grid.Column="3" Content="Favourites only" IsChecked="{Binding FavouritesOnly}"/></Grid>
    <Grid Grid.Row="1" RowDefinitions="*,Auto">
     <ScrollViewer Name="ToolsScroll" HorizontalScrollBarVisibility="Disabled"><ItemsControl Margin="0,0,18,18" Name="ToolList" ItemsSource="{Binding ToolSections}">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ToolSection"><Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,18" BorderThickness="0">
       <ItemsControl ItemsSource="{Binding Tools}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ToolCardViewModel">
         <Border Classes="card" Width="{Binding CardWidth}" Margin="0,0,18,18" Padding="18" MinHeight="{Binding CardHeight}">
          <Grid>
          <StackPanel IsVisible="{Binding !IsListView}" Spacing="12">
           <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><Button Content="Details" IsVisible="{Binding IsDashboard}" Command="{Binding DetailsCommand}" Padding="8,3" FontSize="11" HorizontalAlignment="Left"/><Button Content="Guide" IsVisible="{Binding !IsDashboard}" Command="{Binding GuideCommand}" Padding="8,3" FontSize="11" HorizontalAlignment="Left"/><Button Content="ReadMe" Command="{Binding ReadmeCommand}" Padding="8,3" FontSize="11" HorizontalAlignment="Left"/></StackPanel><Button Grid.Column="1" Command="{Binding FavouriteCommand}" ToolTip.Tip="Toggle favourite" Padding="6"><TextBlock Text="{Binding FavouriteGlyph}" Foreground="#C89A25"/></Button></Grid>
           <Button Command="{Binding IconCommand}" IsEnabled="{Binding Owner.Idle}" ToolTip.Tip="{Binding IconTip}" HorizontalAlignment="Center" Background="Transparent" Padding="0"><Grid Width="84" Height="84"><Border Background="#EDEBFF" CornerRadius="9" IsVisible="{Binding !HasIcon}"><TextBlock Text="{Binding Initial}" Foreground="#5145AA" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="Uniform"/></Grid></Button>
           <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock Text="{Binding Author, StringFormat='by {0}'}" Classes="caption" TextAlignment="Center"/></StackPanel>
           <Grid ColumnDefinitions="*,Auto"><ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedCardPackage, Mode=TwoWay}" HorizontalAlignment="Stretch" MinWidth="110"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:ToolPackage"><TextBlock Text="{Binding Version}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanUse}" Padding="9,6" Margin="6,0,0,0"/></Grid>
           <TextBlock Text="{Binding UpdateStatus}" Classes="caption" TextAlignment="Center"/>
          </StackPanel>
          <Grid IsVisible="{Binding IsListView}" ColumnDefinitions="52,*,140" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
           <Button Command="{Binding IconCommand}" IsEnabled="{Binding Owner.Idle}" ToolTip.Tip="{Binding IconTip}" Background="Transparent" Padding="0"><Grid Width="52" Height="52"><Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="Uniform"/><TextBlock Text="{Binding Initial}" IsVisible="{Binding !HasIcon}" FontSize="32" Foreground="#5145AA" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button>
           <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Author, StringFormat='by {0}'}" Classes="caption"/><TextBlock Text="{Binding UpdateStatus}" Classes="caption"/></StackPanel>
           <Grid Grid.Column="2" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedCardPackage, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:ToolPackage"><TextBlock Text="{Binding Version}" FontSize="12"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
           <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"><Button Content="ReadMe" Command="{Binding ReadmeCommand}" Padding="8,6" Margin="0,0,5,5"/><Button Content="Guide" Command="{Binding GuideCommand}" Padding="8,6" Margin="0,0,5,5"/><Button Content="★" Command="{Binding FavouriteCommand}" ToolTip.Tip="Toggle favourite" Padding="8,6" Margin="0,0,5,5"/><Button Content="Details" IsVisible="{Binding IsDashboard}" Command="{Binding DetailsCommand}" Padding="8,6" Margin="0,0,5,5"/><Button Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanUse}" Padding="9,6" Margin="0,0,5,5"/></WrapPanel>
          </Grid>
          </Grid>
         </Border>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </Expander></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl></ScrollViewer><StackPanel Grid.Row="1" Spacing="6" Margin="0,10,0,0"><TextBlock Text="{Binding VisibleCount}" Classes="caption"/></StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" Grid.Column="1" Name="DetailsScroll" IsVisible="{Binding DetailsVisible}" Width="320" Margin="16,0,0,0"><StackPanel Margin="0,0,18,18" Spacing="12" IsVisible="{Binding HasSelection}"><Button Content="Close details" Command="{Binding CloseDetailsCommand}"/>
     <TextBlock Text="{Binding SelectedTool.Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding SelectedTool.Author}" Classes="caption"/>
     <TextBlock Text="{Binding SelectedTool.Compatibility}" TextWrapping="Wrap"/>
     <Button Content="★ Toggle favourite" Command="{Binding FavouriteCommand}" IsEnabled="{Binding Idle}"/>
     <TextBlock Text="Available versions" FontWeight="SemiBold"/>
     <ComboBox Name="PackagePicker" ItemsSource="{Binding AvailablePackages}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate x:DataType="model:ToolPackage"><TextBlock Text="{Binding FileName}"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <Button Name="InstallButton" Content="Download selected version" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" HorizontalAlignment="Stretch"/>
     <Button Content="README" Command="{Binding ReadmeCommand}" IsEnabled="{Binding Idle}"/>
     <Button Content="Open user guide" Command="{Binding GuideCommand}" IsEnabled="{Binding Idle}"/>
     <TextBlock Text="Installed versions / rollback" FontWeight="SemiBold" Margin="0,15,0,0"/>
     <ComboBox ItemsSource="{Binding InstalledVersions}" SelectedItem="{Binding SelectedInstallation, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="model:InstalledTool"><TextBlock Text="{Binding Version}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     <Button Content="Open selected installed version" Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}" HorizontalAlignment="Stretch"/>
     <Button Content="Activate / roll back to this version" Command="{Binding PinVersionCommand}" IsEnabled="{Binding CanLaunch}"/>
     <Button Content="Remove selected version…" Command="{Binding RemoveVersionCommand}" IsEnabled="{Binding CanLaunch}"/>
     <TextBlock Text="{Binding SelectedInstallation.Directory}" Classes="caption" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsAssistant}" RowDefinitions="Auto,Auto,*"><StackPanel Orientation="Horizontal" Spacing="10"><TextBox Width="500" Text="{Binding Query}" PlaceholderText="Describe your task…"/><Button Content="Find tools" Command="{Binding RecommendCommand}"/><Button Content="Index READMEs" Command="{Binding IndexDocumentationCommand}" IsEnabled="{Binding Idle}"/></StackPanel><StackPanel Grid.Row="1" Margin="0,14" Spacing="8"><TextBlock Text="{Binding AssistantStatus}" TextWrapping="Wrap"/><ScrollViewer MaxHeight="260"><SelectableTextBlock Margin="0,0,18,18" Text="{Binding AssistantConversation}" TextWrapping="Wrap"/></ScrollViewer></StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding Recommendations}" Padding="0,0,18,18"><ListBox.ItemTemplate><DataTemplate x:DataType="assistant:Recommendation"><StackPanel Margin="12" Spacing="5"><TextBlock Text="{Binding Tool.Name}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding Tool.Category}"/><TextBlock Text="{Binding Score, StringFormat='Similarity: {0:P0}'}"/><Button Content="View tool" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectRecommendationCommand}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
   <ContentControl Grid.Row="1" Name="UsefulLinksViewer" IsVisible="{Binding IsLinks}"/>
   <Grid Grid.Row="1" IsVisible="{Binding IsNews}" RowDefinitions="Auto,*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh from GitHub" Command="{Binding RefreshNewsCommand}"/><Button Content="Reset to official news" Command="{Binding ResetNewsCommand}"/></StackPanel><ContentControl Grid.Row="1" Name="NewsViewer"/><Expander Grid.Row="2" Header="Edit local news" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="8"><TextBox AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding News}" Height="180"/><Button Content="Save local news" Command="{Binding SaveNewsCommand}" HorizontalAlignment="Left"/></StackPanel></Expander></Grid>
   <ScrollViewer Grid.Row="1" IsVisible="{Binding IsProfile}"><StackPanel Spacing="16" Margin="0,0,18,18">
    <Border Classes="card"><Grid ColumnDefinitions="86,*,220"><Grid Width="68" Height="68"><Border CornerRadius="34" Background="#A755CF"><TextBlock Text="{Binding ProfileInitial}" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Image Source="{Binding ProfilePhoto}"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8"><TextBlock Text="{Binding ProfileName}" FontSize="25" FontWeight="Bold"/><TextBlock Text="Developer" Classes="caption"/><TextBlock Text="{Binding ProfileStatus}" Classes="caption" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="Developer" Classes="caption"/><ComboBox IsEnabled="{Binding Idle}" ItemsSource="{Binding Authors}" SelectedItem="{Binding ProfileName}" HorizontalAlignment="Stretch"/><Button Content="Load shared profile" Command="{Binding LoadSharedProfileCommand}"/></StackPanel></Grid></Border>
    <Border Classes="card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="📌  Pinned message" FontWeight="SemiBold" Foreground="#5145C0"/><Button Grid.Column="1" Content="Edit" Command="{Binding EditProfileCommand}"/></Grid><TextBlock Text="{Binding ProfileMessage}" TextWrapping="Wrap"/><TextBlock Text="Synced with Box" Classes="caption"/>
     <StackPanel IsVisible="{Binding EditingProfile}" Spacing="10"><TextBox Text="{Binding ProfileMessage}" MaxLength="280" AcceptsReturn="True" MinHeight="80"/><TextBlock Text="Shared links: title | URL | optional Jira key"/><TextBox Text="{Binding ProfileLinksText}" AcceptsReturn="True" MinHeight="80"/><Button Content="Change profile photo…" Command="{Binding ChangePhotoCommand}"/><Button Content="Save to Box" Command="{Binding SaveSharedProfileCommand}"/></StackPanel>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Jira tickets / Shared links" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ProfileLinks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="profile:ProfileLink"><Grid ColumnDefinitions="*,Auto" Margin="0,6"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Key}" Classes="caption"/></StackPanel><Button Grid.Column="1" Content="Open ↗" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenProfileLinkCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <UniformGrid Columns="5"><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileApplications}" FontSize="24" FontWeight="Bold"/><TextBlock Text="applications" Classes="caption" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileVersions}" FontSize="24" FontWeight="Bold"/><TextBlock Text="versions published" Classes="caption" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileUpdates}" FontSize="24" FontWeight="Bold"/><TextBlock Text="updates this year" Classes="caption" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding ProfileActiveDays}" FontSize="24" FontWeight="Bold"/><TextBlock Text="active days" Classes="caption" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="card"><StackPanel><TextBlock Text="{Binding ProfileStreak}" FontSize="24" FontWeight="Bold"/><TextBlock Text="longest streak (days)" Classes="caption" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
    <Border Classes="card"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,150"><TextBlock Text="Box contributions" FontSize="18" FontWeight="SemiBold"/><NumericUpDown Grid.Column="1" Value="{Binding ContributionYear}" Minimum="1970" Maximum="9998" Increment="1" FormatString="0"/></Grid><TextBlock Text="{Binding ContributionSummary}" TextWrapping="Wrap" Classes="caption"/><ScrollViewer HorizontalScrollBarVisibility="Auto"><ItemsControl Margin="0,0,18,18" ItemsSource="{Binding ContributionDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Vertical" Height="105"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ContributionCell"><Button Width="12" Height="12" MinWidth="0" MinHeight="0" Padding="0" CornerRadius="2" Margin="1.5" Background="{Binding Colour}" BorderThickness="0" ToolTip.Tip="{Binding Label}" IsEnabled="{Binding HasDate}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectContributionDayCommand}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Applications" FontSize="18" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding ProfileTools}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ToolCardViewModel"><Grid ColumnDefinitions="*,120,Auto" Margin="0,6"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Classes="caption"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="View in Store" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenProfileToolCommand}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Activity" FontSize="18" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{Binding ProfileEventFilter}" Command="{Binding SelectContributionDayCommand}" ToolTip.Tip="Show all days"/></Grid><ItemsControl ItemsSource="{Binding ProfileEvents}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="profile:ContributionEvent"><Grid ColumnDefinitions="100,70,*,*" Margin="0,5"><TextBlock Text="{Binding Date}" Classes="caption"/><TextBlock Grid.Column="1" Text="{Binding Kind}" Classes="caption"/><TextBlock Grid.Column="2" Text="{Binding Tool}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding File}" Classes="caption" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <Expander Header="Personal Jira shortcut and local activity" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><TextBox Text="{Binding JiraUrl}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Save profile" Command="{Binding SaveSettingsCommand}"/><Button Content="Open Jira" Command="{Binding OpenJiraCommand}"/></StackPanel><SelectableTextBlock Text="{Binding ProfileActivity}"/></StackPanel></Expander>
   </StackPanel></ScrollViewer>
   <ScrollViewer Name="SettingsScroll" Grid.Row="1" IsVisible="{Binding IsSettings}"><StackPanel Margin="0,0,18,18" Spacing="12" MaxWidth="760" HorizontalAlignment="Stretch">
    <TextBlock Text="Box Manager server"/><TextBox Text="{Binding BoxManagerUrl}"/><TextBlock Text="Velopack update feed"/><TextBox Text="{Binding UpdateFeedUrl}"/>
    <TextBlock Text="Theme (System, Light or Dark)"/><TextBox Text="{Binding Theme}"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding Idle}"/>
    <TextBlock Text="Refresh mode" FontWeight="SemiBold"/><TextBlock Text="1: All metadata + documents · 2: Selected tools · 3: Metadata only · 4: New tools only" TextWrapping="Wrap"/><NumericUpDown Value="{Binding RefreshMode}" Minimum="1" Maximum="4" Increment="1" FormatString="0"/><TextBox PlaceholderText="Mode 2: comma-separated folder names (Name-Author)" Text="{Binding RefreshSelectedFolders}"/>
    <Button Content="Activity log" Command="{Binding NavigateCommand}" CommandParameter="Logs"/><TextBlock Text="Application updates" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock Text="{Binding AppVersion, StringFormat='Installed release: {0}'}"/><TextBlock Text="{Binding AppReleaseChannel, StringFormat='Update channel: {0}'}" Classes="caption"/><Button Content="View this release" Command="{Binding OpenApplicationReleaseCommand}" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Check" Command="{Binding CheckUpdatesCommand}"/><Button Content="Download update" Command="{Binding DownloadUpdateCommand}"/><Button Content="Restart to update" Command="{Binding ApplyUpdateCommand}"/></StackPanel><TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"/>
    <TextBlock Text="Import from the Python application" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"/><Button Name="BrowsePythonInstallation" Content="Import tools from the Python installation…" Command="{Binding BrowseLegacyCommand}" IsEnabled="{Binding Idle}" HorizontalAlignment="Left"/><TextBox PlaceholderText="Existing DinoSaurList folder" Text="{Binding LegacyRoot}"/><TextBlock Text="{Binding LegacySummary}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Preview import" Command="{Binding PreviewLegacyCommand}" IsEnabled="{Binding Idle}"/><Button Content="Import previewed items" Command="{Binding ImportLegacyCommand}" IsEnabled="{Binding Idle}"/></StackPanel>
    <TextBlock Text="Per-user data directory" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"/><SelectableTextBlock Text="{Binding DataDirectory}" TextWrapping="Wrap"/><Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}"/>
   </StackPanel></ScrollViewer>
   <ListBox Grid.Row="1" IsVisible="{Binding IsLogs}" ItemsSource="{Binding Logs}" Padding="0,0,18,18"/>
  </Grid>
  <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,1,0,0" BorderBrush="#40808080" Padding="24,10"><Grid ColumnDefinitions="*,180"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><ProgressBar Grid.Column="1" Value="{Binding Progress}" IsVisible="{Binding Busy}" Height="6" Margin="12,0,0,0"/></Grid></Border>
 </Grid>
</Window>
